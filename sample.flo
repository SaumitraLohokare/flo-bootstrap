-- Generics
type A<T> = {
    x: T,
};

fn A<T>(x: T) -> A<T> = A<T> { x };

---

-- Lambdas

type Vec<T> = {
    x: T,
    y: T,
    z: T,
};

fn apply<T>(vec: Vec<T>, f: (Vec<T>) -> Vec<T>) -> Vec<T> = {
    vec |> f
};

fn apply<T, E>(vec: Vec<T>, f: (Vec<T>) -> Vec<T> + E) -> Vec<T> = {
    vec |> f
};

fn main() = {
    let vec = Vec<i32> {};

    -- Sugar for last param is a lambda
    let new_vec = vec |> apply { v ->
        v.x *= 2;
    };

    -- Captures `vec` => type `(Vec<i32>) -> Vec<i32> + { Vec<i32> }`
    let another_vec = vec |> apply { v ->
        v.x += vec.x;
    };

    let lambda = { a, b -> a + b };
    lambda(vec.x, new_vec.x)
};

---

-- Macros

macro try! `e:expr` = {
    match (e)
        | Ok(t) => t
        | Err(e) => return Err(e);
};

fn foo() -> Result<i32, bool> = ...;
fn bleh() -> i32 = {
    let foo_i32 = try! foo();
    foo_i32 * 2
};

macro println! `(es:[]expr, ...)` = {
    for e in es {
        print(e);
    }
    println();
};

---

-- Type System:
--
-- 1. Generate function constraints
-- 2. Solve as many as possible
--   a. Only if all types are known specialize generic functions
--   b. When call has overloads, prune them based on known types
-- 3. Default literal types
-- 4. Solve again
--   a. Specialize generic functions as types become concrete
--   b. When call has overloads, prune them based on known types

---

for { let iter = list |> iter; var it = iter |> next }; it |> is_some; { it = iter |> next } {
    let Some(x) = it else unreachable();

    -- Continue using x
}

for_each! x : list {

}

macro for_each(s: Stream, out: Tokens) -> Error {
    let iter_var_name = s |> expect_get(Ident);
    s |> expect(Colon);
    let iter_on_this = try! s |> parse_expr;
    let body = try! s |> parse_expr;
    if !(body is Expr::Block) {
        return Error::Some("For Each Body must be a block expresion", body.loc, "Expected a block expression");
    }

    out |> emit(Token::For)
        |> emit(Token::LCurly)
        |> emit(Token::Let)
        -- ...
        ;

    Error::None
}

