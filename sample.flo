-- Match
match 0
    | 0 => true
    | 1 => {
            0;
            false
        }
    | _ => true

fn unwrap<T, E>(res: Result<T, E>) -> T
    = match res
        | Ok(item) => item
        | Err(err) => err |> to_string |> abort;

