-- =============================================================================
--  FLO -- FIRST SPECIFICATION
--
--  The feature set the first version of the compiler targets. This is also
--  meant to be the minimal subset the language needs in order for the compiler
--  to be rewritten in itself.
--
--  1. Lexical structure
--  2. Types
--  3. Declarations
--  4. Expressions
--  5. Generics
--  6. Programs & modules
--  7. Implementation status
-- =============================================================================


-- =============================================================================
--  1. LEXICAL STRUCTURE
-- =============================================================================

--- 1.1 Comments

-- A comment runs from `--` to the end of the line.

-- Which means the space in `a - -b` is load bearing: `a --b` is `a` followed by
-- a comment.

--- 1.2 Literals

fn int_lit() -> i32 = 0; -- it can coerce to any integral type
fn flt_lit() -> f32 = 0.0; -- it can also coerce to any float type
-- can omit the trailing 0 => 0. == 0.0
fn bool_lit() -> bool = true; -- or false
fn char_lit() -> u8 = 'a'; -- char literals are u8

-- String literals also allow multi-line
let code: string = "
#version core 330

int main() {
    // shader code
}
";

-- String and char literals allow the same escape sequences as C

-- A number literal always begins with a digit: `.5` is not one. A leading `.`
-- always starts a type literal (2.7).

--- 1.3 Trailing commas

-- Trailing commas are allowed everywhere there is a comma separated list


-- =============================================================================
--  2. TYPES
-- =============================================================================

--- 2.1 Primitive types

-- u8 u16 u32 u64     unsigned integers
-- i8 i16 i32 i64     signed integers
-- f32 f64            floats
-- bool               true / false
-- void               the type of an expression that yields no value
-- noreturn           the type of an expression that never yields (see 4.6)

-- Cannot do: type Id = i32;
-- No plan to add typedef for first spec

--- 2.2 Pointers

-- Uses the same syntax as C
fn swap(a: *i32, b: *i32) = {
    let temp = *b;
    *b = *a;
    *a = temp;
};

fn pointers() -> i32 = {
    let a = 10;
    let b = 20;
    let c = 30;

    &a |> swap(&c); -- & and * bind tighter than any binary op (even pipe)
    a + b
};

-- This follows the same rules as C. values taken address of are always l_value, etc.

-- The null pointer is `nil`
let null_ptr: *i32 = nil;

-- We also have pointer arithmetic, same as C

--- 2.3 Arrays

let arr: [3]i32 = [1, 1, 0];

fn arrays() = {
    let a = arr[0];
    let b = arr[1];
    arr[2] = a + b;

    -- The pointer to the first element can be taken like this:
    let ptr = &arr;

    -- unlike C, arrays are not treated as pointers.
    -- In the future we'd like to add bounds checking for arrays
};

-- Arrays can be multi dimensional
let ident: [2][2]i32 = [
    [1, 0],
    [0, 1],
];

--- 2.4 Slices

let slice: []i32 = [1, 2, 3, 4]; -- arrays can be implicitly typed to slices
-- A slice is simply a pointer and a length
-- Rest everything is similar to arrays

-- slices can also be multi dimensional
-- TODO: How would you implicitly slice a multi-dim array?

--- 2.5 Strings

let s: string = "Hello, World!";
-- Internally, string == []u8
-- So all strings are length based instead of null terminated

-- All strings are also modifiable
fn change_s() = s[12] = '?'; -- This would've been UB in C

-- This does mean that in each function the strings are copied
fn copied_strings() = {
    let a = "Hi"; -- String get's copied every time
    a[0] = 'G';
};

-- There should be a future optimization to put strings in .rodata
-- if they're not modified & remove the copy

--- 2.6 Records & sums

-- There are two kinds of user defined type, and they are not interchangeable.

-- A RECORD is a set of fields, all of them present at once.
type Vec2 = { x: i32, y: i32 };

-- A SUM is a choice between named cases, exactly one of which is present. A
-- case may carry a payload, and a payload is always a record.
type Option<T> = Some { T } | None;

-- Which kind a declaration is, is decided by what follows the `=`: a `{` makes
-- it a record, a case name makes it a sum. So a one case sum is a thing you can
-- write, and it is NOT the same type as the record of that case's fields --
-- it is still a choice, of one, and `.` does not reach into it (2.8).
type Wrapper = W { v: i32 };        -- a sum with one case
type Holder  = { v: i32 };          -- a record

-- A record's fields are either all named or all positional. Mixing the two in
-- one record is an error.
type Named = { x: i32, y: i32 };    -- named:      order is not part of the type
type Pos   = { i32, bool };         -- positional: order IS the type

-- A positional field's name is its index, written `_0`, `_1`, ... So `_` followed
-- by digits is not available as a field name in a named record.

-- Types and functions have separate namespaces
-- Globals also have a separate namespace

-- Recursive types whose size cannot be calculated aren't allowed, all types must have a fixed size at
-- compile time

--- 2.7 Anonymous types & composition

-- Anywhere a type may be written, ANY type may be written. A record body and a
-- sum body are types in their own right, so they nest freely:

type Player = {
    pos: { x: i32, y: i32 },        -- an anonymous record
    dim: { w: i32, h: i32 },
    status: Alive | Dead,           -- an anonymous sum
};

-- The same holds for an argument, a return type and a `let` annotation:
fn anon_record(pos: { x: i32, y: i32 }) -> i32 = pos.x + pos.y;
fn anon_sum(status: Alive | Dead) -> Alive | Dead = status;

-- An anonymous type written down is CONCRETE -- it is not something still being
-- inferred. Two of them are the same type when they have the same shape:
-- fields by name (order does not matter) or by position (order does), and cases
-- by name. Both `pos` and the argument of `anon_record` above have one type.

-- An anonymous type is NEVER equal to a declared type of the same shape. A
-- `Player` is not a `{ pos: .., dim: .., status: .. }`, and cannot be passed
-- where one is expected. Declared types are nominal; that is the whole point of
-- declaring one.

-- An anonymous sum needs at least two cases: with one, `|` is missing and there
-- is nothing to tell a case name from an ordinary type name. So `Alive` on its
-- own is a mention of a type called `Alive`, and `Alive | Dead` is an anonymous
-- sum of two cases.

--- 2.8 Type literals

-- A literal begins with `.` and never names a type. A record literal names no
-- name at all; a case literal names only the CASE, and several types may have a
-- case by that name. So which type a literal is comes from its context -- the
-- annotation, argument type or return type it flows into.

fn record_lit() -> Vec2 = .{ x: 0, y: 0 };  -- named fields, in any order
fn positional() -> Pos  = .{ 0, true };     -- positional fields, in order
fn case_lit() -> Option<i32> = .Some .{ 0 };
fn no_payload() -> Option<i32> = .None;     -- a case with no payload

fn nested() -> Player = .{
    pos: .{ x: 0, y: 0 },
    dim: .{ w: 0, h: 0 },
    status: .Alive,
};

-- A literal may be qualified with a type name, for readability or to pin down a
-- type nothing else would:
fn qualified() -> Vec2 = Vec2.{ x: 0, y: 0 };
fn qualified_case() -> Option<i32> = Option.Some.{ 0 };
--                                   ^--- the type
--                                         ^--- the case

-- A qualifier names the type and nothing else: its type ARGUMENTS cannot be
-- written, because no type may be written inside an expression at all (2.9). So
-- `Vec.{ .. }` says which declaration this is and leaves `T` to inference. To
-- force a type argument, annotate what the value flows into (5.3).

-- A record literal may leave fields out. What is left out is zero initialized.
-- A field that is not a field of the record, or one given twice, is an error.
fn partial() -> Player = .{ pos: .{ x: 1, y: 2 } };   -- dim and status zeroed

-- Zero initializing a sum yields its FIRST case, with a zeroed payload -- the
-- tag is zero like everything else.

--- 2.9 No types inside expressions

-- Nothing in an expression may name a type. There is no turbofish, no `Type` as
-- an operand, and no way to spell a type argument at a call site. The three
-- builtins are the exceptions, and each takes a type where a call would take a
-- value, which is what makes them not calls: `@cast(T) x` (4.9), `@sizeof(T)`
-- and `@alignof(T)` (4.10).

-- This is what buys the `.` on every literal: since an identifier can never be
-- followed by a literal `{`, a `{` after a condition is always a scope, and a
-- bare name is always a variable or a call. Nothing has to be resolved to know
-- what was written.

--- 2.10 Field access

fn field_access(p: Player) = {
    let x = p.pos.x;
    p.pos.x = 100;

    let pair: Pos = .{ 0, true };
    let first = pair._0;        -- positional fields are `_0`, `_1`, ...
};

-- `.` reaches into a RECORD only -- declared, anonymous, or still being
-- inferred. Every sum is rejected, one case sums included: which case is
-- present is a runtime question, and `match` (4.8) is the only thing that
-- answers it.

--- 2.11 Layout

-- A record is a C struct: fields in declaration order.
-- A sum is a C struct of a tag and a union of the case payloads. The tag takes
-- the smallest uint that fits the case count, and cases are tagged in
-- declaration order.


-- =============================================================================
--  3. DECLARATIONS
-- =============================================================================

--- 3.1 Functions

fn main() = println("Hello, World!");

--- 3.2 Arguments & Return

fn add(a: i32, b: i32) -> i32 = a + b;

--- 3.3 Overloading

fn add(a: i32, b: i32) -> i32 = a + b;
fn add(a: u32, b: u32) -> u32 = a + b;

-- Having multiple similar or same overloads isn't an error in itself
-- The error comes from not being able to decide an overload at call site

--- 3.4 Operators

op +(a: i32, b: i32) -> i32 = -- ...

-- The operator set is the same as C's
-- Operators on primitive types are built-in
-- Only the dereference and address of and [] operators cannot be overloaded

-- Two of the built-in ones are not quite C's:

-- `!` is logical negation of a bool, and nothing else. There is no truthiness,
-- so an integer is not something that can be negated. (`~` does have a bool
-- overload, the way `&`, `|` and `^` do.)
fn not_a_number() -> bool = !1;        -- error: no `!` takes an integer

-- `<<` and `>>` are the only operators whose operands need not agree: what is
-- being shifted decides the result type, and the amount only says how far.
fn shift(v: i32, by: u8) -> i32 = v << by;      -- fine, yields i32

-- Neither `<<` nor `>>` is a single token, because `View<View<i32>>` closes two
-- argument lists with two `>` in a row. A shift is two of them written with
-- nothing in between, so `a >> b` shifts and `a > > b` is an error.

-- `&&` and `||` cannot be overloaded either. They short-circuit -- the right
-- operand is only evaluated when the left one does not already decide the
-- answer -- and a call cannot promise that, since its arguments are all
-- evaluated before it runs. So they are not calls at all: both operands must be
-- bool, the result is bool, and that is the whole of it.
op &&(a: bool, b: bool) -> bool = a;    -- error: `&&` cannot be overloaded

--- 3.5 External functions

extern fn println(s: string);
-- External functions to interop with C
-- All functions in the langauge use C ABI
-- There will be a separate function to convert a string
-- to cstring. Our language will only use length based strings.
-- A C string will be *u8

--- 3.6 Global Variables

let global_counter: i32 = 0; -- Global vars must always be given a type

-- Global variables don't allow shadowing

-- Their rhs assignment must only be a constexpr.
-- A const expr is one where all expressions are either literals,
-- A later update will allow function calls of pure functions.
-- A function is pure if it doesn't use any global variables,
-- and doesn't call any external functions, and doesn't call any
-- other impure function

-- There is no `use` declaration. There is nothing for one to do: a case name is
-- only ever written after a `.`, where it cannot be mistaken for anything else,
-- so no name needs bringing into scope to make it writable.


-- =============================================================================
--  4. EXPRESSIONS
-- =============================================================================

--- 4.1 Scope expr

-- A scope is a list of statements followed by an optional tail expression.
-- A statement is a `let` (4.2) or an expression written for its effect. Only the
-- tail has a value, and it is the scope's.

-- EVERY statement ends in a `;`. There is no implicit one: a scope, an `if` or a
-- `while` written in statement position needs its `;` like anything else, and
-- the tail is the one expression that goes without. That is how the two are told
-- apart.

fn scope_ex() = {}; -- Empty scope evaluates to void
fn scope_ex() = {
    print("Hi");
    print("Hi");
    {                   -- Scopes can also be inserted in
        print("Hi");
    };                  -- and are statements like any other
    if foo() {
    };
    while foo() {
    };
    print("Hi")         -- the tail: no `;`
};
fn scope_ex() -> i32 = { 0 }; -- Scopes have implicit return

-- The `;` is not a formality. An expression may begin with `.` (2.8), and `.`
-- also means field access, so `if c { } .Alive` could be read either way. The
-- separator is what makes the answer never depend on how it was spaced.

--- 4.2 Variables

fn var() -> u8 = {
    let x = 10; -- This is mutable
    x = 2;
    let y: u8 = 1; -- Can specify types

    {
        let x = 32; -- shadowing is allowed
        y = x;
    };

    x + y
};

fn var() = {
    let x; -- This is ok, we will figure out it's type from usage, the space is reserved, and zero initialized by default
    x = 20;

    -- let can only occur at statement level inside a scope
    -- Anywhere else is illegal. A statement has no value, so a `let` always
    -- ends in a `;` -- it can never be the scope's tail.
};

--- 4.3 If expr

fn if_ex(a: bool) -> u8 = if a { 0 } else { 1 };
-- Both branches of a complete if must have the same type

fn dangling_if(a: bool) -> void = if a {
    -- Do something
};
-- An incomplete if evaluates to void & it's body must also evaluate to void

-- The if body must be a scope
-- The else body can be a scope or another if (allows `else if`)

-- A body that is not a scope is not allowed. It could not be: a body may begin
-- with `.`, and the condition would take that as a field access on itself.

--- 4.4 While

fn while_ex() = while false {
    -- Do something
};
-- while always evaluates to void
-- it's body also must be a scope that evaluates to void

--- 4.5 Break & Continue

fn break_continue() = {
    while foo() {
        if bar() { break };
        if baz() { continue };
    };
};
-- break and continue must be inside a loop
-- They also evaluate to noreturn type

--- 4.6 Return expr

fn foo() -> i32 = return 0;
-- return evaluates to noreturn type
-- noreturn unifies with any other type
-- type of expr after return must unify with return type

fn foo() = return;
-- No expr after return means return void

--- 4.7 Piping

fn foo(a: i32) -> bool = -- ...
fn bar(a: bool) -> i32 = -- ...

fn main() = 0 |> foo |> bar;

-- The piped value is passed in as the first argument
-- additional arguments can be passed further

fn baz(a: i32, b: i32) -> i32 = -- ...

fn main() = 0 |> foo() |> bar() |> baz(1);

--- 4.8 Match expr

-- `match` is the only way to read a sum: which case is present is a runtime
-- question, so it is answered by branching on it.

type Shape = Circle { r: i32 } | Rect { w: i32, h: i32 };

fn area(s: Shape) -> i32 = match s {
    .Circle .{ r }   -> r * r * 3,
    .Rect .{ w, h }  -> w * h,
};

fn describe(n: i32) -> i32 = match n {
    0            -> 10,
    1            -> 20,
    x if x < 0   -> 30,
    _            -> 40,
};

-- Arms are comma separated, a trailing comma is allowed, and each arm's body is
-- one expression. The commas are required: an arm body may end where the next
-- pattern begins with `.`, and without a separator the two would run together.

-- A pattern is a literal, `_`, a case (`.Case`, with or without a payload
-- pattern), a record pattern, or a binding. A bare identifier is always a
-- BINDING, never a comparison against a variable of that name -- use a guard for
-- that. In a record pattern a bare identifier binds the field it stands for:
-- by name for a named record (`.{ r }` binds `r`), by position for a positional
-- one (`.{ a, b }` binds the first and second).

-- An arm may carry a guard, `if <expr>`, which is checked after the pattern
-- matches. A guarded arm never counts towards exhaustiveness.

-- Every match must be exhaustive. Ranges are not patterns (no `v @ 1..10`).

--- 4.9 Casting

let cast_from: i32 = 20;
let cast_to: u8  = @cast(u8) cast_from;

-- @cast does a simple bit-cast
-- It can give a warning if the sizes of the two types
-- arent the same.

--- 4.10 Size & Align

let size: u64 = @sizeof(i32); -- Can only take a type as argument
let align: u64 = @alignof(i32); -- Same here


-- =============================================================================
--  5. GENERICS
-- =============================================================================

--- 5.1 Generic functions

fn add<T>(a: T, b: T) -> T = a + b;

-- Every call site can specialize a new version of the generic.

-- A generic function is never checked on its own -- it has no single type.
-- Only its specializations are checked, which has two consequences:
--   - A generic nothing ever calls is never checked at all.
--   - A mistake in the body is reported for the specialization that exposes
--     it, at the place in the body where it is, with a note naming the
--     specialization. See 5.3.

--- 5.2 Generic types

type View<T> = { data: *T, len: u64 };

-- Similarly every use of this type can be specialized

--- 5.3 Specialization

fn Vec<T>() -> Vec<T> = .{ data: nil, len: 0 };

fn uses() = {
    let a = 10;
    let b = 20;

    let view_a = View.{ data: &a, len: 1 };

    let new_view = view_a |> add(view_b); -- ERROR, the error will be printed in `add`
                                          -- Error because it tried to monomorphize and failed

    -- A type argument is never written at a call site (2.9), so the way to say
    -- what one is, is to annotate what the call flows into:
    let v: Vec<u8> = Vec();

    -- With nothing to infer from, it is an error -- there is no `T` to pick.
    let unknown = Vec();                  -- ERROR: cannot infer T
};

-- All this follows from literals naming a case and never a type: the return
-- type or argument type is what tells us which type a literal is, and the same
-- machinery is what settles a generic's arguments.


-- =============================================================================
--  6. PROGRAMS & MODULES
-- =============================================================================

--- 6.1 The main function

fn main(args: []string) = {
    -- This is how to get cmdline args
};

-- main function can either take no args or []string
-- and it can return void or i32

-- main cannot have any overloads

--- 6.2 Multi File

-- Importing single files only allowed
-- No complex modules system

-- Imports foo.flo from relative to this file
-- All imported functions and globals are visible
-- by default
import "./foo.flo"

-- Imports it under foo namespace
import foo "./foo.flo"

-- imports from foo will be visible inside `foo::`
let imported: i32 = foo::a;

-- `::` is the module separator and nothing else. A type's cases are reached
-- with `.` (2.8), so `foo::Option.Some.{ 0 }` is a case of a type in a module.

-- If the path isn't relative, it checks the folder the compiler is present in
-- And the folder the compiler was run from
import "std/vec.flo";

-- The std library will be present in compiler folder

-- To make something public, use pub
pub fn add(a: i32, b: i32) -> i32 = a + b;

pub type Foo = { bar: i32 }; -- All fields are public like C struct

pub let a: i32 = 100;

-- Recursive imports are ok

-- No forced structure for code by compiler


-- =============================================================================
--  7. IMPLEMENTATION STATUS
-- =============================================================================

--- 7.1 Implemented

-- 1.1  Comments
-- 1.2  Integer, float and bool literals, and their coercion
-- 1.3  Trailing commas, in the comma separated lists that exist so far
-- 2.1  Primitive types -- except `noreturn` as something you can write down
-- 2.6  Records & sums: both kinds of declaration, named and positional fields,
--      case payloads, and the rejection of a type that has no size
-- 2.7  Anonymous records and sums, everywhere a type may be written, nested
--      freely -- structural, concrete, and never equal to a declared type
-- 2.8  Type literals: `.{ .. }`, `.Case`, `.Case .{ .. }`, and the qualified
--      `Vec2.{ .. }` / `Option.Some.{ .. }` forms whose type arguments are
--      inferred. Fields left out of a record literal are zero initialized
-- 2.9  No types inside expressions, `@cast`/`@sizeof`/`@alignof` excepted
-- 2.10 Field access, and assignment through it -- on records only
-- 3.1  Functions
-- 3.2  Arguments & return
-- 3.3  Overloading, on argument types AND on return type
-- 3.4  `op` overloads, and the built-in operators on primitives -- the whole
--      set, `!`, `~`, `<<` and `>>` included -- with `&&` and `||` rejected as
--      overloads because they short-circuit
-- 4.1  Scope expr, with the mandatory `;` and the implicit tail value
-- 4.2  Variables: `let` with/without a type, with/without an initializer,
--      shadowing, and assignment
-- 4.3  If expr, including `else if`
-- 4.4  While
-- 4.5  Break & continue
-- 4.6  Return, and `noreturn` as an internal type
-- 4.7  Piping
-- 5.1  Generic functions
-- 5.2  Generic types
-- 5.3  Specialization, of functions and of types
-- 4.9  @cast, as the bit-cast between any two types that have bits. Its type
--      is the one written into it, and it says nothing about its operand's; the
--      size-mismatch case is a warning, so it waits on a diagnostic sink
-- 4.10 @sizeof / @alignof -- checked, and u64. The number each yields is a
--      property of the target, so it is codegen that will work it out
-- 6.1  The main function -- except the `[]string` argument form

-- Also, not visible in the spec but done: whole-function type inference, with
-- literal defaulting ({integer} -> i32, {decimal} -> f32) and overload
-- resolution iterated to a fixpoint. Overload resolution sees generic and
-- ordinary functions as one set, so the two can overload each other.

-- And, on 2.6/2.8: a literal does not pick a type when it is written -- a
-- record literal names nothing, and a case literal names only a case, which
-- several types may have. So it gets an OPEN type of what it is known to have,
-- which narrows as it meets other types: merging with another open one, or
-- becoming a declared type when it reaches an annotation or a function
-- boundary. One that never meets a declared type CLOSES into the anonymous type
-- of exactly what it had. Written out:
--
--      SomeRecord --> AnonRecord    (nothing pinned it)
--                 \-> declared record type
--      SomeSum    --> AnonSum
--                 \-> declared sum type
--
-- An open record is the one type that can still GROW: unifying two of them
-- takes the union of their fields, which is what makes a field left out of one
-- literal and given in another end up in both (zero initialized in the first).
-- An open type is never `is_known`; closing it is what makes it concrete.

--- 7.2 Not implemented

-- Types & data
-- 2.2  Pointers: `*T`, `&x`, `*p`, `nil`, pointer arithmetic
-- 2.3  Arrays: `[N]T`, array literals, indexing, `&arr`
-- 2.4  Slices: `[]T`, implicit array -> slice, `slice.count`
-- 2.5  Strings: the `string` type, string and char literals, escape
--      sequences, multi-line literals, and the copy-on-use rule
-- 2.11 Layout (record lowering, tag + union lowering). Nothing lowers yet.
--      Recursive types through a pointer: every field holds its type by value
--      today, so the size check rejects any cycle at all; a `*T` field will
--      break the cycle once 2.2 exists.

-- Declarations
-- 3.5  External functions
-- 3.6  Global variables & their constexpr initializers

-- Expressions
-- 4.8  match, its patterns, and exhaustiveness checking. Until it lands a sum
--      can be declared and built but not read: `.` is rejected on every sum,
--      and there is nothing else that looks inside one.

-- Operators & builtins
-- 3.4  The short circuit in `&&` and `||` itself. The front end models them
--      as their own expression rather than a call, which is what makes them
--      un-overloadable, but nothing actually skips the right operand yet --
--      that is codegen's job, and there is no codegen.

-- Programs
-- 6.1  `main(args: []string)` -- blocked on 2.4 and 2.5
-- 6.2  Multi file: `import`, namespaced import, `pub`

-- Compiler infrastructure -- not language features, but needed
-- - Warnings of any kind. The @cast size-mismatch warning (4.9) needs a
--   diagnostic sink that is not error-only.
-- - Tokenizer error reporting. It panics on an unknown character or a
--   malformed number instead of reporting one.
-- - Deterministic error ordering. Functions are checked by iterating a
--   HashMap, so errors come out in a random order.
-- - Code generation. Nothing exists yet; the plan is to transpile to C.

--- 7.3 Suggested order

