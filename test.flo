type Status =
    | Ok
    | NotOk { msg: String };

fn foo(status: Status) = match status {
    | Ok => 200
    | NotOk { msg } => match msg {
        | "not_found" => 404
        | "internal_error" => 500
        | _ => 400
    } 
};

