op +(x: Result, y: i32) = match x {
    Ok => y + 1,
    Err => y,
};

op +(x: MyResult, y: i32) = match x {
    Ok => y + 1,
    Err1 => y,
    Err2 => y - 1,
};

type Result = Ok | Err;

type MyResult = Ok | Err1 | Err2;

