import casl "casl";
import rl   "raylib";

var N;
var saturation;
var value;

fn main() = {
    let casl = casl::init();
    defer casl |> close();

    casl |> file("./config.casl");
    casl |> var(&mut N,          "config.N");
    casl |> var(&mut saturation, "config.saturation");
    casl |> var(&mut value,      "config.value");

    rl::init_window(800, 600, "Experiment");
    defer rl::close_window();

    while !rl::window_should_close() {
        casl |> hot_reload();
        
        rl::begin_draw();
        -- draw stuff

        rl::draw_rect(Rect(width: 20, height: 30), Color(0x181818FF));

        rl::end_draw();
    }

    --------

    var watcher;
    fw::init(&mut watcher) { change ->
        log("Change for path ", change.path, " : ", change.events);
    } |> or_abort("Failed to open file watcher");
};

